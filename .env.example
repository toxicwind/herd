# Environment Configuration - Agentic Lens-First
# NEVER hardcode secrets. Inject via env or runtime vault.
GITHUB_TOKEN=
OPHEL_VAULT_PATH=
MODELBEATS_API_ENDPOINT=
ZEDRA_DAEMON_HOST=localhost:17357
MUSEPOOL_CDN_PRIMARY=alibaba
MCP_TRANSPORT=stdio
LENS_ENABLED=true
LENS_SWARM_CONCURRENCY=4
LENS_AUTO_COMMIT=false
SWARM_MAX_CONCURRENCY=4
SWARM_TIMEOUT_MS=30000

# ─── LLM Provider API Keys ───────────────────────────────────────────
# Only set the providers you plan to use.
CEREBRAS_API_KEY=<redacted>
FIREWORKS_API_KEY=<redacted>
GROQ_API_KEY=<redacted>
HYPERBOLIC_API_KEY=<redacted>
MISTRAL_API_KEY=<redacted>
NVIDIA_API_KEY=<redacted>
OPENAI_API_KEY=<redacted>
OPENROUTER_API_KEY=<redacted>
OVH_API_KEY=<redacted>
OVHCLOUD_API_KEY=<redacted>
PERPLEXITY_API_KEY=<redacted>
POLLINATIONS_API_KEY=<redacted>
# Alias honored by the freeproxy pollinations client:
# POLLINATIONS_KEY=<redacted>
SILICONFLOW_API_KEY=<redacted>
TOGETHER_API_KEY=<redacted>

# ─── Service / Gateway Config ────────────────────────────────────────
# Kimi backend base URL override (used by live astmatrix tests)
KIMI_API_URL=
# API key for the wol-proxy llama-swap front
LLAMA_SWAP_API_KEY=<redacted>
# Cache directory override (default: OS cache dir)
CACHE_DIR=
# Cloudflare AI Gateway polling (freeproxy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
# Poll base override; when empty the client builds it from account/gateway id
CLOUDFLARE_GATEWAY_POLL_BASE=

# ─── mcpproxy (mesh/gateway) ─────────────────────────────────────────
# Token / API key used by mcpproxy credential commands and tray auth
MCPPROXY_TOKEN=<redacted>
MCPPROXY_API_KEY=<redacted>
MCPPROXY_SERVER_URL=
MCPPROXY_CORE_URL=
MCPPROXY_CORE_PATH=
MCPPROXY_CERTS_DIR=
MCPPROXY_TLS_ENABLED=false
MCPPROXY_TELEMETRY=false
# Set by the launcher when mcpproxy is spawned by pitchfork
MCPPROXY_LAUNCHED_BY=
# Allow eval scans inside Docker (default off)
MCPPROXY_SCAN_EVAL_DOCKER=false
# mcpproxy-tray options
MCPPROXY_TRAY_LISTEN=127.0.0.1
MCPPROXY_TRAY_PORT=
MCPPROXY_TRAY_ENDPOINT=
MCPPROXY_TRAY_SKIP_CORE=false
MCPPROXY_TRAY_RETRY_DELAY=
MCPPROXY_TRAY_CORE_TIMEOUT=
MCPPROXY_TRAY_STATE_DEBUG=false
MCPPROXY_TRAY_EXTRA_ARGS=
MCPPROXY_TRAY_CONFIG_PATH=

# lact daemon socket path override (GPU control)
LACT_DAEMON_SOCKET_PATH=
