{
  "name": "herd-llama-swap",
  "version": "18.1.14",
  "description": "Maximal sovereign herd — llama-swap engine with mesh orchestration",
  "main": "llama-swap.go",
  "scripts": {
    "build": "cd ui-svelte && bun run build",
    "dev": "cd ui-svelte && bun run dev",
    "start": "go run ./cmd/main.go",
    "test": "go test ./... && bun run test --root ui-svelte",
    "lint": "cd ui-svelte && bun run check",
    "go-mod": "go mod download && go mod tidy",
    "ui-install": "cd ui-svelte && bun install",
    "full-install": "go mod download && cd ui-svelte && bun install && bun add -g tsx typescript svelte @sveltejs/vite-plugin-svelte vite @tailwindcss/vite tailwindcss",
    "docker-build": "docker build -t llama-swap ./docker/unified",
    "benchmark": "go test -bench=. ./internal/bench/..."
  },
  "dependencies": {
    "go": "^1.23.1",
    "bun": "^1.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "vite": "^8.1.0",
    "@tailwindcss/vite": "^4.1.8",
    "tailwindcss": "^4.1.8",
    "vitest": "^4.1.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2",
    "go": ">=1.23.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toxicwind/herd.git"
  },
  "keywords": ["llama-swap", "herd", "mesh", "sovereign", "inference"],
  "author": "toxicwind",
  "license": "MIT"
}
